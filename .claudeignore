# ===========================
# EduMakon Admin — .claudeignore
# ===========================
# Claude ushbu fayllarni kontekstga yuklamaydi.
# Maqsad: token sarfini kamaytirish, sezgir ma'lumotlarni himoya qilish.

# --- Dependency va build ---
node_modules/
dist/
dist-ssr/
build/
.cache/
.vite/

# --- Environment (sezgir ma'lumotlar) ---
.env
.env.*
!.env.example

# --- Lock fayllar (katta, kodga keraksiz) ---
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Log fayllar ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor va OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- TypeScript build artifacts ---
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Test coverage ---
coverage/
.nyc_output/

# --- Generated fayllar ---
src/assets/icon/index.tsx
# (iconlar avtomatik generate qilingan, o'qish shart emas)

# --- JSON ma'lumot fayllari (katta statik data) ---
src/json/
public/

# --- Font fayllar (binary) ---
src/assets/fonts/
*.woff
*.woff2
*.ttf
*.otf
*.eot

# --- Rasm fayllar (binary) ---
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.svg
# Komponent sifatida import qilingan SVG'lar bundan mustasno (icon/)

# --- PDF va boshqa binary ---
*.pdf
*.zip
*.tar.gz

# --- Git ---
.git/
.gitignore

# --- Misc ---
*.map
.eslintcache
.stylelintcache
